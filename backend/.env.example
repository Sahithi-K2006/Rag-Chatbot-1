# Copy to backend/.env and fill in. Never commit the real .env file.

# --- Deployment mode ---
# "production" refuses to start unless API_ACCESS_KEY is set.
ENVIRONMENT=development

# --- Language model (Google Gemini) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Writes the answers. Stable model with a usable free tier.
LLM_MODEL=gemini-2.5-flash
# Classifies each message (greeting / summary / document question) and rewrites it into an English search query.
# Leave empty to save quota: rule-based routing, one model call per message (weaker on Telugu, typos and follow-ups).
LLM_ROUTER_MODEL=gemini-2.5-flash-lite
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=60

# --- Access control & limits ---
# Shared key the browser must send as X-Access-Key. REQUIRED for any deployment other people can reach.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(24))"
API_ACCESS_KEY=
# Frontend origins allowed to call the API (comma-separated, no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CHAT_REQUESTS_PER_MINUTE=20
UPLOADS_PER_MINUTE=10
MAX_UPLOAD_MB=10
MAX_DOCUMENTS=200
MAX_QUESTION_CHARS=2000

# --- Embeddings & retrieval ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# cpu | cuda | mps
EMBEDDING_DEVICE=cpu
CHUNK_SIZE=700
CHUNK_OVERLAP=120
TOP_K=5
# Cosine similarity 0..1. The best passage must reach MIN_SIMILARITY or the assistant says the documents
# don't cover the question; other passages down to CONTEXT_MIN_SIMILARITY are then given as context.
MIN_SIMILARITY=0.30
CONTEXT_MIN_SIMILARITY=0.20
SUMMARY_CHUNKS=8

# --- Storage ---
# Uploaded files, documents.json and the Chroma index. Must be on persistent storage in production.
# DATA_DIR=/var/data
